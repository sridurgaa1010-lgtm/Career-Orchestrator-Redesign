# Copy to .env (never commit .env). No real secrets in this file. Every variable is optional: the app runs with none of them.
APP_MODE=replay                    # replay (default, no keys needed) | live (only after an LLM provider is tested)
DB_PATH=./app.db                   # SQLite file. USER DATA ONLY
CORS_ORIGINS=*                     # dev default. Demo on one laptop serving frontend_dist needs no CORS
ALLOW_UNVERIFIED_RESOURCES=true    # show seed_unverified courses WITH a visible "not verified" badge
ALLOW_SAMPLE_RESOURCES=true        # show sample_placeholder courses WITH a visible "sample" badge; set false once verified courses exist
# --- Language model (Skills Discovery agent and Course Scout). Only the "gemini" provider is built. Without a key the app uses rules. ---
# To run live: put these in a local .env file (never committed), set APP_MODE=live, and restart.
LLM_PROVIDER=                      # gemini
LLM_MODEL=                         # optional; default gemini-2.5-flash
LLM_API_KEY=                       # your Google AI Studio key. Never paste it into chat, code or GitHub
LLM_RECORD=false                   # true = save each live answer to data/v2/replay/ so the demo can replay it offline. Use ONLY with the synthetic demo person.
RATE_LIMIT_PER_MIN=40              # per-client limit on the endpoints that may call the model
