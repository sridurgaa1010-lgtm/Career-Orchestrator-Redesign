{
 "$defs": {
  "Consent": {
   "additionalProperties": false,
   "properties": {
    "given": {
     "title": "Given",
     "type": "boolean"
    },
    "version": {
     "default": "2026-10-v1",
     "title": "Version",
     "type": "string"
    },
    "at": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "At"
    }
   },
   "required": [
    "given"
   ],
   "title": "Consent",
   "type": "object"
  },
  "Preferences": {
   "additionalProperties": false,
   "properties": {
    "interest_tags": {
     "description": "Ordered, most preferred first (max 3)",
